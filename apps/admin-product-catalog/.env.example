# Gateway origin. Every request the SPA makes goes here; nothing talks to
# auth-service or product-service directly.
VITE_API_BASE_URL=http://localhost:8080

# This SPA's origin. Must appear verbatim in the gateway's
# GATEWAY_CORS_ALLOWED_ORIGINS and (with /auth/callback) in auth-service's
# AUTH_ALLOWED_REDIRECT_URIS, which are exact-match allow-lists.
VITE_APP_ORIGIN=http://localhost:5173
