# =============================================================================
# Single source of configuration for deploy.sh and destroy.sh.
#
#   cp deploy/aws/config.example.env deploy/aws/config.env     # config.env is gitignored
#   $EDITOR deploy/aws/config.env
#   ./deploy/aws/deploy.sh
#
# This file holds real secrets once filled in. It is never committed, and nothing in it is baked
# into an image: values go to AWS Secrets Manager and reach the pods through External Secrets.
# =============================================================================

# --- where ----------------------------------------------------------------------------------------
AWS_REGION=ap-south-1
# Named AWS CLI profile to use. Blank = the default credential chain (env vars, SSO, instance role).
AWS_PROFILE=

# --- naming ---------------------------------------------------------------------------------------
# Every resource is named <PROJECT>-<ENVIRONMENT>-...; the pair is also the confirmation word
# destroy.sh asks you to type.
PROJECT=ecommerce
ENVIRONMENT=prod

# --- your domain ----------------------------------------------------------------------------------
# Root domain you control, e.g. example.com. The platform is served at
#   https://shop.<domain>   storefront        https://admin.<domain>   admin + seller portal
#   https://api.<domain>    API (reachable only through CloudFront)
# deploy.sh creates the Route 53 hosted zone if there is none; you then point your registrar's
# nameservers at it (the script prints them and waits).
DOMAIN_NAME=example.com

# --- size -----------------------------------------------------------------------------------------
# lean : cheapest working topology. Single NAT gateway, single-AZ database, one Redis node, small
#        Kafka brokers, every autoscaler clamped to 1-3 pods. Use it for the first dry run.
# prod : full HA. NAT per AZ, Multi-AZ database, Redis with failover, larger Kafka brokers,
#        interface VPC endpoints, autoscalers sized for real traffic.
SIZE_PROFILE=lean

# --- alerts ---------------------------------------------------------------------------------------
# CloudWatch alarms (database CPU/storage/connections, Redis CPU) are sent here. AWS emails a
# confirmation link you must click.
ALERT_EMAIL=

# --- payments (REQUIRED) --------------------------------------------------------------------------
# payment-service REFUSES TO START in production without a real Stripe key; the dev "simulated"
# mode would let a customer mark their own order as paid.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google sign-in (optional) ---------------------------------------------------------------------
# Leave blank to run with password / OTP login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- optional ---------------------------------------------------------------------------------------
# CIDRs allowed to reach the public Kubernetes API (kubectl/helm). Comma separated.
# Narrow this to your office / CI addresses for production.
KUBERNETES_API_ALLOWED_CIDRS=0.0.0.0/0
# Only let CloudFront open connections to the load balancer, so the WAF cannot be bypassed.
# Set to false if ALB creation fails with a security-group rule quota error.
RESTRICT_ALB_TO_CLOUDFRONT=true
# Image tag override. Default: the git commit SHA (plus a hash of uncommitted changes).
IMAGE_TAG=
# true = skip building and uploading the two single-page apps.
SKIP_FRONTENDS=false
