# Static product-image server with CRUD over HTTP (nginx WebDAV).
#   Read   GET    /images/<path>        public, ETag-revalidated
#   List   GET    /images/<dir>/        JSON directory listing
#   Create PUT    /images/<path>        needs X-Image-Token (parent dirs are created)
#   Update PUT    /images/<path>        same call: overwrites in place, URL unchanged
#   Delete DELETE /images/<path>        needs X-Image-Token
# ${IMAGE_SERVER_TOKEN} is substituted by the nginx image's envsubst step at container start.

map "$request_method:$http_x_image_token" $image_write_ok {
    default                          0;
    ~^(GET|HEAD|OPTIONS):            1;
    "PUT:${IMAGE_SERVER_TOKEN}"      1;
    "DELETE:${IMAGE_SERVER_TOKEN}"   1;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 25m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /images/ {
        if ($image_write_ok = 0) { return 403; }

        alias /data/images/;
        dav_methods PUT DELETE;
        create_full_put_path on;
        dav_access user:rw group:r all:r;
        autoindex on;
        autoindex_format json;

        # Files are replaced in place when an image is updated, so browsers must revalidate (cheap 304).
        add_header Cache-Control "no-cache" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        # Only images are ever stored; refuse to serve anything that could run as a page.
        types { image/jpeg jpg jpeg; image/png png; image/webp webp; image/gif gif; image/avif avif; }
        default_type application/octet-stream;
    }
}
