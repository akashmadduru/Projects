# Copy to infra/.env (gitignored) and fill in. Used by docker-compose for the
# platform service containers added in Phases 1B-1E.
#
#   cp infra/.env.example infra/.env

# --- host port overrides (optional; set if the defaults collide locally) ---
# POSTGRES_PORT=15432
# ZOOKEEPER_PORT=12181
# ADMIN_CATALOG_PORT=3001
# PRODUCT_CATALOG_PORT=3000

# --- service database passwords (must match infra/postgres/init/01-schemas.sql) ---
AUTH_DB_PASSWORD=auth_service_local_pwd
PRODUCT_DB_PASSWORD=product_service_local_pwd
INVENTORY_DB_PASSWORD=inventory_service_local_pwd
USER_DB_PASSWORD=user_service_local_pwd
CART_DB_PASSWORD=cart_service_local_pwd
ORDER_DB_PASSWORD=order_service_local_pwd
RATING_DB_PASSWORD=rating_service_local_pwd

# --- JWT signing keystore (created by infra/scripts/generate-keystore.sh) ---
JWT_KEYSTORE_PASSWORD=change-me
JWT_KEYSTORE_ALIAS=jwt-signing

# --- auth-service (Phase 1C) ---
# Self-service registration is OFF by default; this is an internal admin console.
AUTH_REGISTRATION_ENABLED=true
# Google OIDC login is OPTIONAL. Leave blank and the Google leg is simply not
# installed - password login, refresh rotation and JWKS all work normally.
# To enable: create an OAuth 2.0 Client ID (type "Web application") in the Google
# Cloud console and add http://localhost:8081/login/oauth2/code/google as an
# Authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- token contract, shared by auth-service, gateway and product-service ------
# All three MUST agree. A mismatch produces "invalid_token" on every
# authenticated request, with nothing in any service's log naming the cause.
# AUTH_JWT_ISSUER=https://auth.acme-ecommerce.internal
# AUTH_JWT_AUDIENCES=ecommerce-platform

# --- Phase 6: payments / promotions / internal service auth ---
PAYMENT_DB_PASSWORD=payment_service_local_pwd
PROMOTION_DB_PASSWORD=promotion_service_local_pwd
# Shared secret for /internal/** service-to-service calls (X-Internal-Token). Generate a long random value.
INTERNAL_API_TOKEN=change-me-long-random-value
# Stripe: leave STRIPE_SECRET_KEY blank to run payment-service in SIMULATED mode (no real charges).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Phase 6: auth emails / notification-service ---
# Origin used in password-reset / verify-email links. Dev mail is caught by Mailpit (http://127.0.0.1:8025).
STOREFRONT_BASE_URL=http://localhost:3000
NOTIFICATION_DB_PASSWORD=notification_service_local_pwd

# --- Email (notification-service). Defaults deliver to the Mailpit container. ---
# Real provider example (Amazon SES / SendGrid / Gmail app password / Mailgun): see
# docs/Setup-Integrations.md. Port 587 => MAIL_SMTP_AUTH=true + MAIL_SMTP_STARTTLS=true;
# port 465 => MAIL_SMTP_AUTH=true + MAIL_SMTP_SSL=true.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_SMTP_SSL=false
# NOTIFICATION_SENDER=no-reply@yourdomain.com

# --- Browser push (optional). Blank => keys are generated on first start and stored in the DB. ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Production edge / cookies (see docs/Setup-Integrations.md, "Going to production") ---
# GATEWAY_CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
# AUTH_ALLOWED_REDIRECT_URIS=https://shop.example.com/auth/callback,https://admin.example.com/auth/callback
# AUTH_DEFAULT_REDIRECT_URI=https://shop.example.com/auth/callback
# AUTH_COOKIE_SECURE=true

# --- Phase 9: seller-service ---
SELLER_DB_PASSWORD=seller_service_local_pwd
# AES-256-GCM key (base64, 32 bytes) for seller bank account numbers: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SELLER_DATA_KEY=

# --- Phase 10: support-service ---
SUPPORT_DB_PASSWORD=support_service_local_pwd

# Phase 10: AES-256-GCM key for TOTP secrets (base64, 32 bytes): openssl rand -base64 32
AUTH_DATA_KEY=
