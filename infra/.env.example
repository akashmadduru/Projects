# Copy to infra/.env (gitignored) and fill in. Used by docker-compose for the
# platform service containers added in Phases 1B-1E.
#
#   cp infra/.env.example infra/.env

# --- host port overrides (optional; set if the defaults collide locally) ---
# POSTGRES_PORT=15432
# ZOOKEEPER_PORT=12181
# ADMIN_CATALOG_PORT=3001
# PRODUCT_CATALOG_PORT=3000

# --- service database passwords (must match infra/postgres/init/01-schemas.sql) ---
AUTH_DB_PASSWORD=auth_service_local_pwd
PRODUCT_DB_PASSWORD=product_service_local_pwd
INVENTORY_DB_PASSWORD=inventory_service_local_pwd

# --- JWT signing keystore (created by infra/scripts/generate-keystore.sh) ---
JWT_KEYSTORE_PASSWORD=change-me
JWT_KEYSTORE_ALIAS=jwt-signing

# --- auth-service (Phase 1C) ---
# Self-service registration is OFF by default; this is an internal admin console.
AUTH_REGISTRATION_ENABLED=false
# Google OIDC login is OPTIONAL. Leave blank and the Google leg is simply not
# installed - password login, refresh rotation and JWKS all work normally.
# To enable: create an OAuth 2.0 Client ID (type "Web application") in the Google
# Cloud console and add http://localhost:8081/login/oauth2/code/google as an
# Authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- token contract, shared by auth-service, gateway and product-service ------
# All three MUST agree. A mismatch produces "invalid_token" on every
# authenticated request, with nothing in any service's log naming the cause.
# AUTH_JWT_ISSUER=https://auth.acme-ecommerce.internal
# AUTH_JWT_AUDIENCES=ecommerce-platform
