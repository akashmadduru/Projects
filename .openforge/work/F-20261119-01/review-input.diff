+    assertThat(Arrays.stream(ErrorCode.values()).map(ErrorCode::code)).doesNotHaveDuplicates();
+    for (ErrorCode c : ErrorCode.values()) {
+      assertThat(c.code()).isEqualTo(c.name());
+    }
+  }
+}
