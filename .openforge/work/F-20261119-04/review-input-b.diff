+          "REFUND FAILED: Razorpay refund {} of {} {} for order {} (refund row {}) failed; "
+              + "balance released, customer NOT refunded",
+          r.providerRefundId(),
+          r.amount(),
+          p.currency(),
+          p.orderId(),
+          r.id());
+    }
+  }
