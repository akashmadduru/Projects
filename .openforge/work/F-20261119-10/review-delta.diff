+    coins.onReturnRefunded(
+        order, user, UUID.randomUUID(), new BigDecimal("900"), ORDER_VALUE, false);
+
+    assertThat(sum(user, "return-redeem-")).isEqualTo(30); // capped at N, never more
+    assertThat(sum(user, "return-earn-")).isEqualTo(-30);
