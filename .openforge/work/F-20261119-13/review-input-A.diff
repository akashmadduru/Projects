+                    + " VALUES (:s, 'FEE_REVERSAL', :a, 'INR', :o, :sh)")
+            .param("s", s)
+            .param("a", new BigDecimal("10.00"))
+            .param("o", UUID.randomUUID())
+            .param("sh", UUID.randomUUID())
+            .update();
+    assertThat(n).isEqualTo(1);
