+        .param("u", UUID.randomUUID())
+        .param("s", "m-" + id)
+        .update();
+    return id;
+  }
+
+  @Test
+  @DisplayName("a FEE_REVERSAL ledger row is accepted")
+  void feeReversalTypeAccepted() {
+    UUID s = seller();
+    int n =
