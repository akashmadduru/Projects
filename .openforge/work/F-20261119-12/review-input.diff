+    UUID u = seedDue();
+    assertThat(privacy.runDue(Instant.now())).isGreaterThanOrEqualTo(1);
+    assertThat(requestStatus(u)).isEqualTo("COMPLETED");
+    assertThat(outboxRows(u)).isEqualTo(1);
