+                .perform(get(BASE).param("status", "pending").with(withRole("ADMIN")))
+                .andReturn()
+                .getResponse()
+                .getStatus())
+        .isEqualTo(200);
+  }
+
+  @Test
+  @DisplayName("GET is capped at 200 rows")
+  void capped() throws Exception {
+    jdbc.sql(
