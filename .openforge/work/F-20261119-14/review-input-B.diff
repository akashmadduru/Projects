+    deliver(b.shipmentIds().get(0));
+
+    returnShipment(b, b.shipmentIds().get(0));
+
+    assertThat(returnShipping(b.orderId())).isEqualByComparingTo("50.00");
+    assertThat(cancelShipping(b.orderId())).isEqualByComparingTo("0");
