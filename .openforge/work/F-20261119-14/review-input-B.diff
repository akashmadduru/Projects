+    publisher.publish(OrderEventType.ORDER_CANCELLED, order());
+
+    OrderEvent e = captured();
+    assertThat(e.returnId()).isNull();
+    assertThat(e.refundAmount()).isNull();
+    assertThat(e.returnItemsValue()).isNull();
+  }
+}
